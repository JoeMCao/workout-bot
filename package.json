{
  "name": "workout-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "debug:last-session": "node scripts/debug-last-session.js",
    "debug:time": "node scripts/debug-time.ts",
    "backfill:strength-activities": "tsx scripts/backfill-strength-activity-sessions.ts",
    "wipe:activities": "tsx scripts/wipe-activity-sessions.ts --yes",
    "wipe:whoop-mappings": "tsx scripts/wipe-whoop-workout-mappings.ts --yes",
    "test:sets": "node --import tsx --test scripts/set-batches.integration.ts",
    "test:whoop": "node --import tsx --test scripts/whoop-body-measurement.integration.ts",
    "test:sensations": "node --import tsx --test scripts/sensation-journal.integration.ts",
    "test:weight": "node --import tsx --test scripts/body-weight.integration.ts",
    "test:health-sync": "node --import tsx --test scripts/health-sync.integration.ts",
    "test:plugin": "node --import tsx --test scripts/plugin-auth.test.ts",
    "plugin:package": "tsx scripts/package-workout-plugin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "latest",
    "dotenv": "^17.4.2",
    "jose": "^6.2.13",
    "mcp-handler": "^2.1.0",
    "next": "latest",
    "pg": "^8.20.0",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "^3.8.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prisma": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
