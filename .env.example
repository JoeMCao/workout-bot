DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
WORKOUT_API_KEY="replace-with-a-long-random-secret"
# Optional: canonical base URL for GET /api/openapi `servers[0].url` (e.g. production for Custom GPT). If unset, uses the request Host.
# OPENAPI_PUBLIC_URL="https://workout-bot-virid.vercel.app"
WHOOP_CLIENT_ID="replace-with-whoop-client-id"
WHOOP_CLIENT_SECRET="replace-with-whoop-client-secret"
# Local dev: http://localhost:3000/... | Vercel production: https://YOUR_DOMAIN/api/auth/whoop/callback (must match WHOOP app exactly).
WHOOP_REDIRECT_URI="http://localhost:3000/api/auth/whoop/callback"
# App-generated secret (not from WHOOP). Used to encrypt tokens at rest. If you change it, existing stored tokens cannot be decrypted—reconnect WHOOP.
WHOOP_TOKEN_ENCRYPTION_KEY="replace-with-a-long-random-secret"
# WHOOP workout/recovery/sleep data API base is fixed in code (`https://api.prod.whoop.com/developer` per OpenAPI). Do not add an env override unless WHOOP changes their documented server URL.
# Optional: set to 1 so POST /api/whoop/sync includes `error.details` in JSON (e.g. Vercel preview). Omit in public production.
# WHOOP_SYNC_EXPOSE_ERRORS="1"
