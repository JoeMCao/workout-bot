generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WorkoutSession {
  id             String        @id @default(cuid())
  startedAt      DateTime      @default(now())
  timeSource     String?
  timezone       String        @default("America/Los_Angeles")
  endedAt        DateTime?
  sessionType    String?
  goal           String?
  readinessScore Int?
  energy         Int?
  soreness       String?
  sleepQuality   String?
  notes          String?
  lowBackPain             Boolean?
  lowBackPainSeverity     String?
  elbowIrritation         String?
  neckTightness           String?
  shoulderIrritation      String?
  fatigueLevel            String?
  motivationLevel         String?
  sorenessAreas           Json?
  readinessNotes          String?
  whoopRecoveryScore      Int?
  whoopSleepPerformance   Float?
  whoopSleepEfficiency    Float?
  whoopHrvRmssd           Float?
  whoopRestingHeartRate   Float?
  whoopStrainYesterday    Float?
  whoopDataFetchedAt      DateTime?
  whoopRaw                Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sets                   ExerciseSet[]
  linkedActivitySessions ActivitySession[]

  @@index([startedAt])
}

model ActivitySession {
  id                      String          @id @default(cuid())
  type                    String
  modality                String?
  startedAt               DateTime
  timeSource              String?
  timezone                String          @default("America/Los_Angeles")
  endedAt                 DateTime?
  durationMinutes         Float?
  intensity               String?
  avgHeartRate            Int?
  maxHeartRate            Int?
  minHeartRate            Int?
  calories                Int?
  distanceMeters          Float?
  elevationGainMeters     Float?
  elevationLossMeters     Float?
  paceSecondsPerKm        Float?
  strain                  Float?
  zone0Minutes            Float?
  zone1Minutes            Float?
  zone2Minutes            Float?
  zone3Minutes            Float?
  zone4Minutes            Float?
  zone5Minutes            Float?
  source                  String?
  notes                   String?
  relatedWorkoutSessionId String?
  relatedWorkoutSession   WorkoutSession?   @relation(fields: [relatedWorkoutSessionId], references: [id], onDelete: SetNull)
  whoopMappings           WhoopWorkoutMapping[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([startedAt])
  @@index([type])
  @@index([relatedWorkoutSessionId])
}

model WhoopConnection {
  id                    String                @id @default(cuid())
  provider              String                @default("whoop")
  whoopUserId           Int?
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenType             String?
  scope                 String?
  expiresAt             DateTime
  lastSyncAt            DateTime?
  lastSyncError         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  workoutMappings       WhoopWorkoutMapping[]

  @@unique([provider])
  @@index([expiresAt])
}

model WhoopWorkoutMapping {
  id                 String            @id @default(cuid())
  connectionId       String
  whoopWorkoutId     String
  whoopUpdatedAt     DateTime?
  activitySessionId  String?
  raw                Json
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  connection         WhoopConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  activitySession    ActivitySession?  @relation(fields: [activitySessionId], references: [id], onDelete: SetNull)

  @@unique([whoopWorkoutId])
  @@index([connectionId])
  @@index([activitySessionId])
}

model Exercise {
  id             String        @id @default(cuid())
  name           String        @unique
  normalizedName String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sets           ExerciseSet[]
}

model ExerciseSet {
  id          String         @id @default(cuid())
  sessionId   String
  exerciseId  String
  setNumber   Int?
  weight      Float?
  reps        Int?
  rpe         Float?
  rir         Float?
  painFlag    Boolean        @default(false)
  painNotes   String?
  notes       String?
  completedAt DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise    Exercise       @relation(fields: [exerciseId], references: [id])

  @@index([sessionId, completedAt])
  @@index([exerciseId, completedAt])
}
