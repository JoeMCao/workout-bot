generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WorkoutSession {
  id             String        @id @default(cuid())
  startedAt      DateTime      @default(now())
  timeSource     String?
  timezone       String        @default("America/Los_Angeles")
  endedAt        DateTime?
  sessionType    String?
  goal           String?
  readinessScore Int?
  energy         Int?
  soreness       String?
  sleepQuality   String?
  notes          String?
  lowBackPain             Boolean?
  lowBackPainSeverity     String?
  elbowIrritation         String?
  neckTightness           String?
  shoulderIrritation      String?
  fatigueLevel            String?
  motivationLevel         String?
  sorenessAreas           Json?
  readinessNotes          String?
  whoopRecoveryScore      Int?
  whoopSleepPerformance   Float?
  whoopSleepEfficiency    Float?
  whoopHrvRmssd           Float?
  whoopRestingHeartRate   Float?
  whoopStrainYesterday    Float?
  whoopDataFetchedAt      DateTime?
  whoopRaw                Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sets                   ExerciseSet[]
  sessionExercises       WorkoutSessionExercise[]
  linkedActivitySessions ActivitySession[]

  @@index([startedAt])
}

/// Per-session exercise metadata: how the canonical Exercise was performed in this workout (not global rename).
model WorkoutSessionExercise {
  id          String   @id @default(cuid())
  sessionId   String
  exerciseId  String
  displayName String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise    Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([sessionId, exerciseId])
  @@index([sessionId])
}

model ActivitySession {
  id                      String          @id @default(cuid())
  type                    String
  modality                String?
  /** Original vendor label (e.g. WHOOP sport_name); not the canonical ActivitySession.type. */
  sourceActivityType      String?
  rawPayloadJson          Json?
  startedAt               DateTime
  timeSource              String?
  timezone                String          @default("America/Los_Angeles")
  endedAt                 DateTime?
  durationMinutes         Float?
  intensity               String?
  avgHeartRate            Int?
  maxHeartRate            Int?
  minHeartRate            Int?
  calories                Int?
  distanceMeters          Float?
  elevationGainMeters     Float?
  elevationLossMeters     Float?
  paceSecondsPerKm        Float?
  strain                  Float?
  zone0Minutes            Float?
  zone1Minutes            Float?
  zone2Minutes            Float?
  zone3Minutes            Float?
  zone4Minutes            Float?
  zone5Minutes            Float?
  source                  String?
  notes                   String?
  /** e.g. needs_review when WHOOP strength could not be auto-linked to a WorkoutSession */
  syncStatus              String?
  relatedWorkoutSessionId String?
  relatedWorkoutSession   WorkoutSession?   @relation(fields: [relatedWorkoutSessionId], references: [id], onDelete: SetNull)
  whoopMappings           WhoopWorkoutMapping[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([startedAt])
  @@index([type])
  @@index([relatedWorkoutSessionId])
}

model WhoopConnection {
  id                    String                @id @default(cuid())
  provider              String                @default("whoop")
  whoopUserId           Int?
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenType             String?
  scope                 String?
  expiresAt             DateTime
  lastSyncAt            DateTime?
  lastSyncError         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  workoutMappings       WhoopWorkoutMapping[]

  @@unique([provider])
  @@index([expiresAt])
}

model WhoopWorkoutMapping {
  id                 String            @id @default(cuid())
  connectionId       String
  whoopWorkoutId     String
  whoopUpdatedAt     DateTime?
  activitySessionId  String?
  raw                Json
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  connection         WhoopConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  activitySession    ActivitySession?  @relation(fields: [activitySessionId], references: [id], onDelete: SetNull)

  @@unique([whoopWorkoutId])
  @@index([connectionId])
  @@index([activitySessionId])
}

/// WHOOP sleep night (daily context). Join to sessions by `localDate` in America/Los_Angeles (prefer wake day from `endedAt`).
model WhoopSleep {
  id                           String    @id @default(cuid())
  sourceSleepId                String?   @unique
  localDate                    String
  startedAt                    DateTime?
  endedAt                      DateTime?
  timezone                     String    @default("America/Los_Angeles")
  scoreState                   String?
  sleepPerformancePercentage   Float?
  sleepConsistencyPercentage   Float?
  sleepEfficiencyPercentage    Float?
  sleepNeededSeconds           Int?
  sleepDurationSeconds         Int?
  timeInBedSeconds             Int?
  awakeTimeSeconds             Int?
  slowWaveSleepSeconds         Int?
  remSleepSeconds              Int?
  lightSleepSeconds            Int?
  respiratoryRate              Float?
  rawPayloadJson               Json?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@index([localDate])
  @@index([startedAt])
}

/// WHOOP morning recovery (daily context). Join to sessions by `localDate` in America/Los_Angeles.
model WhoopRecovery {
  id                 String    @id @default(cuid())
  sourceRecoveryId   String?   @unique
  localDate          String
  cycleId            String?
  sleepId            String?
  timezone           String    @default("America/Los_Angeles")
  scoreState         String?
  recoveryScore      Int?
  restingHeartRate   Float?
  hrvRmssdMilli      Float?
  spo2Percentage     Float?
  skinTempCelsius    Float?
  rawPayloadJson     Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([localDate])
  @@index([cycleId])
  @@index([sleepId])
}

model Exercise {
  id             String                   @id @default(cuid())
  name           String                   @unique
  normalizedName String                   @unique
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  sets           ExerciseSet[]
  sessionEntries WorkoutSessionExercise[]
}

model ExerciseSet {
  id          String         @id @default(cuid())
  sessionId   String
  exerciseId  String
  setNumber   Int?
  weight      Float?
  reps        Int?
  rpe         Float?
  rir         Float?
  painFlag    Boolean        @default(false)
  painNotes   String?
  notes       String?
  completedAt DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise    Exercise       @relation(fields: [exerciseId], references: [id])

  @@index([sessionId, completedAt])
  @@index([exerciseId, completedAt])
}
